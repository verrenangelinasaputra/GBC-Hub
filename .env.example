PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-24-chars
NODE_ENV=development

# Login (tanpa database — disimpan di memori server dari env)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=SuperAdmin123!

OWNER_USERNAME=owner
OWNER_PASSWORD=Owner123!

# Google Sheets (wajib untuk tabel & dashboard)
# 1. Buat Service Account di Google Cloud, aktifkan Google Sheets API
# 2. Download JSON key, simpan di folder aman (jangan commit)
# 3. Share kedua spreadsheet ke email service account (Editor atau Viewer)
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/google-service-account.json

# Opsional — override ID/range (default sudah sesuai link Anda)
# KAS_BESAR_SHEET_ID=1jgcaW0NLr_FFyVpGa483mMNSqhGBeuxtocRhMj3IyyY
# KAS_BESAR_SHEET_GID=1533749503
# KAS_KECIL_SHEET_ID=1vQYT4cVRxM8f3qnwWpXupB3SrZbb7Uc7H5ykTXpddiM
# KAS_KECIL_SHEET_GID=423968165

# Owner — Business insights (Google AI Studio / Gemini API)
# Jangan commit key ke git. Rotasi key jika pernah terpapar.
# Key baru AI Studio bisa format AIza… atau AQ. (auth key) — keduanya dipakai via header x-goog-api-key.
# Jika key AQ. gagal terus (free_tier limit 0), aktifkan billing di GCP project key tersebut atau buat key baru.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Saat model sibuk / 503, nyalakan fallback ke model lain:
# GEMINI_USE_FALLBACK=true
# GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite,gemini-2.5-flash
# GEMINI_INSIGHT_CACHE_MS=1800000
# GEMINI_RETRY_PER_MODEL=2
# GEMINI_MAX_OUTPUT_TOKENS=2048
