PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-24-chars
NODE_ENV=development

# Login (tanpa database — disimpan di memori server dari env)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
# ADMIN_DISPLAY_NAME=Admin

SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=SuperAdmin123!

OWNER_USERNAME=owner
OWNER_PASSWORD=Owner123!

# Registrasi user → Google Sheet + verifikasi email (lihat docs/USER_AUTH_SETUP.md)
# USERS_REGISTRY_SPREADSHEET_ID=1MRM3lQ37fKHezJ7QW8IdTTuvXRhIvUBjA2cVjZJ3CqE
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="GBC Cash Management <you@gmail.com>"
# MAIL_DEV_LOG=true

# Google Sheets (wajib untuk tabel, input web & compile)
# 1. Buat Service Account di Google Cloud, aktifkan Google Sheets API
# 2. Download JSON key, simpan di folder aman (jangan commit)
# 3. Share spreadsheet HUB ke email service account sebagai **Editor**
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/google-service-account.json
# Vercel: paste isi file JSON service account (satu baris) — jangan commit
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Spreadsheet pusat (tab KAS KECIL, KAS BESAR, compiled table, ENTITAS, LAPORAN BULANAN)
HUB_SPREADSHEET_ID=1sRiwrn_nLHhp3mb1qyEnC0mxnleLSwF5AbsfuQ0o-LY
# HUB_KAS_KECIL_TAB=KAS KECIL
# HUB_KAS_BESAR_TAB=Bank
# HUB_KAS_KECIL_GID=1585130450
# HUB_KAS_BESAR_GID=604908609

# Upload bukti transaksi (Google Drive API harus enabled di project GCP)
# Buat folder Drive, share ke service account (Editor), salin ID folder dari URL
# GOOGLE_DRIVE_BUKTI_FOLDER_ID=

# Upload otomatis ke Drive pribadi (Gmail) — OAuth sekali, lihat docs/DRIVE_BUKTI_SETUP.md
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/drive/callback
# Set true hanya jika masih baca sheet lama hasil Google Form (tanpa input web ke hub):
# USE_LEGACY_FORM_SHEETS=true

# --- Vercel (Environment Variables di dashboard) ---
# SESSION_SECRET=... (min 24 karakter, wajib)
# NODE_ENV=production
# ADMIN_* / OWNER_* / GEMINI_* sama seperti di atas
# GOOGLE_SERVICE_ACCOUNT_JSON=... (bukan path file)
# HUB_SPREADSHEET_ID=1sRiwrn_nLHhp3mb1qyEnC0mxnleLSwF5AbsfuQ0o-LY

# Owner — Business insights (Google AI Studio / Gemini API)
# Jangan commit key ke git. Rotasi key jika pernah terpapar.
# Key baru AI Studio bisa format AIza… atau AQ. (auth key) — keduanya dipakai via header x-goog-api-key.
# Jika key AQ. gagal terus (free_tier limit 0), aktifkan billing di GCP project key tersebut atau buat key baru.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Saat model sibuk / 503, nyalakan fallback ke model lain:
# GEMINI_USE_FALLBACK=true
# GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite,gemini-2.5-flash
# GEMINI_INSIGHT_CACHE_MS=1800000
# GEMINI_RETRY_PER_MODEL=2
# GEMINI_MAX_OUTPUT_TOKENS=2048
